<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- §3.3 chess combat feedback: check/mate/victory vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Run / walk quest proof via the hardware step counter (foreground service) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Scheduled war reminders + recovery countdown between quest blocks -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".TheSystemApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.System.Starting">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground HEALTH service: step / distance / active-time tracking only.
             Runs through music, app switching and lock screen. Camera proof is
             always an in-app screen — never backgrounded. -->
        <service
            android:name=".service.StepCounterService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- DISCIPLINE ENGINE (0.24.0 spec §5–§7) — one sentinel, three laws:
             quest-locked social blocker, always-on porn shield, anti-uninstall
             guardian. All verdicts are local & deterministic. -->
        <service
            android:name=".service.SystemDisciplineService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/discipline_service_config" />
        </service>

        <!-- §6.3 DNS GUARD — opt-in Cloudflare Family filter (1.1.1.3/1.0.0.3).
             Only resolver IPs cross the tunnel; nothing else is intercepted. -->
        <service
            android:name=".service.SystemDnsGuardService"
            android:exported="true"
            android:label="@string/dns_guard_label"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- §7 DEVICE GUARD — anchors the anti-uninstall law. -->
        <receiver
            android:name=".service.SystemDeviceAdminReceiver"
            android:exported="true"
            android:label="@string/app_name"
            android:description="@string/device_guard_desc"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- §7 SYSTEM ABANDONMENT PROTOCOL — the confession ritual. -->
        <activity
            android:name=".ui.discipline.AntiUninstallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="false"
            android:windowSoftInputMode="adjustResize|stateVisible"
            android:theme="@style/Theme.System.Starting" />

        <receiver android:name=".service.QuestReminderReceiver" android:exported="false" />
        <receiver android:name=".service.RoutineBootReceiver" android:exported="true" android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
