<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="240"
    android:viewportHeight="240"
    android:tint="#FFFFFF">
    <!--
      THE SYSTEM cold-start mark.
      Android 12+ splash icons are masked to the central 2/3 safe circle
      (~160/240), so every stroke stays inside radius 76 of the centre —
      nothing is clipped. A precision-instrument watch bezel: thin ring,
      12 o'clock index, one pivot dot. Pure white on black, no hue.
    -->
    <!-- bezel ring -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:fillColor="#00000000"
        android:pathData="M120,46 A74,74 0 1 1 119.9,46 Z" />
    <!-- 12 o'clock index -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M120,56 L120,70" />
    <!-- 3 / 6 / 9 quiet ticks -->
    <path
        android:strokeColor="#888888"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M184,120 L172,120 M120,184 L120,170 M56,120 L68,120" />
    <!-- pivot dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M120,120 m-9,0 a9,9 0 1 0 18,0 a9,9 0 1 0 -18,0" />
</vector>
